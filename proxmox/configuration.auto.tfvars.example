# Proxmox
proxmox_api_url = "https://192.168.1.25:8006/"
proxmox_api_token_id = "root@pam!supersecret"
proxmox_api_token_secret = "js7ej5k9-hd75-hd64-js56-js834jmd732"
proxmox_target_node = "your-proxmox-node"
proxmox_storage_device   = "samsung-ssd"

# Talos Linux
# Talos version needs to correspond to the install_image version in node_data
# See: https://github.com/siderolabs/terraform-provider-talos/blob/main/docs/data-sources/machine_configuration.md
talos_version                  = "1.13.8"
kubernetes_version             = "1.36.3"
# With these variables you can configure the ISO images which are uploaded to Proxmox for initially booting the VMs
talos_linux_iso_image_url = "https://factory.talos.dev/image/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515/v1.13.8/nocloud-amd64.iso"
talos_linux_iso_image_filename = "talos-linux-v1.13.8-qemu-guest-agent-amd64.iso"
# Name of the cluster
cluster_name = "your-cluster-name"
# VIP address for the control planes, see https://www.talos.dev/v1.13/talos-guides/network/vip/
cluster_vip_shared_ip = "192.168.10.100"
# The node configuration, adjust it to your liking
# hostname is optional per node, without it Talos Linux generates one itself.
# Optionally you can configure the resources per node with cpu_cores, memory (MB) and disk_size (GB),
# defaults are: control planes 2 cores, 8192 MB, 50 GB / workers 2 cores, 16384 MB, 50 GB
node_data = {
    controlplanes = {
      "192.168.10.101" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-cp-0"
        cpu_cores     = 2
        memory        = 8192
        disk_size     = 50
      },
      "192.168.10.102" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-cp-1"
      },
      "192.168.10.103" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-cp-2"
      },
    }
    workers = {
      "192.168.10.104" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-worker-0"
      },
      "192.168.10.105" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-worker-1"
      },
      "192.168.10.106" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-worker-2"
      },
      "192.168.10.107" = {
        install_disk  = "/dev/vda"
        install_image = "factory.talos.dev/nocloud-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.13.8"
        hostname      = "your-cluster-name-worker-3"
      },
    }
  }
# Network configuration, which is applied to all nodes
network            = "192.168.10.0/24"
network_gateway    = "192.168.10.1"
domain_name_server = "192.168.10.1"

# Cilium
# Enables the Cilium Ingress controller
# See: https://docs.cilium.io/en/stable/network/servicemesh/ingress/
ingress_controller_enabled = true

